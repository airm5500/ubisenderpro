<?xml version="1.0" encoding="UTF-8"?>
<!--
  UbiSenderPro — Relevé de compte : SOUS-RAPPORT « Règlements ».
  Utilisé par releve.jrxml. Personnalisable comme les autres modèles en le
  copiant dans le répertoire des rapports (D:\REPORTS par défaut).
  Champs : date, mode, reference, montant (déjà mis en forme).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="releve_paiements" language="java"
              pageWidth="515" pageHeight="842" columnWidth="515"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">

    <style name="Entete" fontName="SansSerif" fontSize="9" isBold="true" forecolor="#FFFFFF"/>
    <style name="Cellule" fontName="SansSerif" fontSize="9" forecolor="#222222">
        <box leftPadding="4" rightPadding="4">
            <pen lineWidth="0.4" lineColor="#C9D4E0"/>
        </box>
    </style>

    <field name="date" class="java.lang.String"/>
    <field name="mode" class="java.lang.String"/>
    <field name="reference" class="java.lang.String"/>
    <field name="montant" class="java.lang.String"/>

    <columnHeader>
        <band height="18">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="515" height="18" backcolor="#2D6CDF"/>
                <staticText><reportElement style="Entete" x="4" y="0" width="86" height="18"/>
                    <textElement verticalAlignment="Middle" textAlignment="Center"/><text><![CDATA[Date]]></text></staticText>
                <staticText><reportElement style="Entete" x="94" y="0" width="106" height="18"/>
                    <textElement verticalAlignment="Middle"/><text><![CDATA[Mode]]></text></staticText>
                <staticText><reportElement style="Entete" x="204" y="0" width="186" height="18"/>
                    <textElement verticalAlignment="Middle"/><text><![CDATA[Référence]]></text></staticText>
                <staticText><reportElement style="Entete" x="394" y="0" width="117" height="18"/>
                    <textElement verticalAlignment="Middle" textAlignment="Right"/><text><![CDATA[Montant]]></text></staticText>
            </frame>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Prevent">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Cellule" x="0" y="0" width="90" height="16"/>
                <textElement verticalAlignment="Middle" textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Cellule" x="90" y="0" width="110" height="16"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{mode}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Cellule" x="200" y="0" width="190" height="16"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="Cellule" x="390" y="0" width="125" height="16"/>
                <textElement verticalAlignment="Middle" textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{montant}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
