# Configuration du compagnon WhatsApp du CRM UBIPHARM (service
# "UBIPHARM CRM - WhatsApp"). Apres une modification, redemarrez ce service.

# Adresse du CRM sur ce poste : messages entrants et accuses distribue / lu
# lui sont renvoyes. Le port suit server.port de application-prod.yml.
CRM_CALLBACK=http://localhost:8080

# Jeton partage avec le CRM (crm.whatsapp.jeton de application-prod.yml),
# genere a l'installation : les deux valeurs doivent rester identiques.
WA_WEB_TOKEN=__JETON_WA_WEB__

# Port d'ecoute, a reporter dans crm.whatsapp.url du CRM s'il change.
PORT=3000

# Niveau de journalisation : info, debug, warn, error.
LOG_LEVEL=info
