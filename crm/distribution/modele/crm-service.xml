<!--
  Service Windows du CRM UBIPHARM (WinSW 2.12).
  %BASE% est le dossier de ce fichier (dossier application) ; la configuration,
  les journaux et les sessions WhatsApp vivent dans le dossier donnees voisin,
  qu'une mise a jour ne remplace pas.
-->
<service>
  <id>ubipharm-crm</id>
  <name>UBIPHARM CRM</name>
  <description>CRM UBIPHARM CI : relances de recouvrement par WhatsApp, e-mail et SMS (interface web sur le port 8080).</description>
  <executable>%BASE%\runtime\bin\java.exe</executable>
  <arguments>-Xms256m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=UTC -jar "%BASE%\crm.jar" --spring.profiles.active=prod --spring.config.additional-location=optional:file:./application-prod.yml</arguments>
  <workingdirectory>%BASE%\..\donnees</workingdirectory>
  <env name="CRM_LOG_DIR" value="%BASE%\..\donnees\logs"/>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <!-- La base MariaDB peut demarrer apres le CRM : le service relance l'application -->
  <onfailure action="restart" delay="20 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <!-- Ctrl+C a Java : arret propre (envois en cours termines) avant l'arret force -->
  <stopparentprocessfirst>true</stopparentprocessfirst>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>%BASE%\..\donnees\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
