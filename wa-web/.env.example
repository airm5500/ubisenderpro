# Configuration du service compagnon WhatsApp Web
# ---------------------------------------------------------------------------
# Copiez ce fichier en « .env » (dans le meme dossier que server.js) et
# adaptez les valeurs. Le fichier .env est lu automatiquement au demarrage :
# plus besoin de « set VAR=... » a chaque ouverture d'invite de commandes.
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux / macOS)
# ---------------------------------------------------------------------------

# OBLIGATOIRE — adresse de l'application UbiSmartCRM Pro.
# Sans cette valeur, les reponses des clients sont recues mais JAMAIS
# transmises : elles n'apparaissent pas dans les Discussions.
UBISENDER_CALLBACK=http://localhost:8080/ubisenderpro

# Jeton partage entre ce service et l'application (doit etre IDENTIQUE des
# deux cotes : ici et dans le parametre correspondant de l'application).
WA_WEB_TOKEN=un-secret-partage

# Port d'ecoute du service (defaut : 3000).
PORT=3000

# Dossier de stockage des sessions WhatsApp (defaut : ./data).
#WA_WEB_DATA=./data

# Niveau de journalisation : info (defaut), debug, warn, error.
#LOG_LEVEL=info
